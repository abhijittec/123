# Public site URL (used for Open Graph / WhatsApp previews)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only — NEVER expose to the browser or commit real values
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# UUID from: select id from public.events where slug = 'diwali-2026';
EVENT_ID=00000000-0000-0000-0000-000000000000

# Pepper for hashing resident edit tokens (use a long random string in production)
EDIT_TOKEN_PEPPER=replace-with-a-long-random-secret

# Optional: max people per flat (default 30)
NEXT_PUBLIC_MAX_HEAD_COUNT=30

# Optional Cloudflare Turnstile (recommended in production)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
